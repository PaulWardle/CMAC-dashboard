# Cloudflare Pages headers
# Applied to every response. Security-hardening defaults that don't break the app.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# The service worker must always be revalidated so updates ship promptly.
/sw.js
  Cache-Control: no-cache

# Hashed build assets are immutable and can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: A Content-Security-Policy is intentionally omitted for now because the
# app injects runtime <style> tags, loads Google Fonts, downloads blob: exports
# and connects to Supabase. Add one once verified in the browser, e.g.:
#   Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.supabase.co;
#   style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self'
#   https://fonts.gstatic.com data:; img-src 'self' data: blob:; script-src 'self'

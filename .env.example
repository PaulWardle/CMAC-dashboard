# ---------------------------------------------------------------------------
# CMAC Operations Command Centre — environment configuration
# Copy this file to `.env` for local dev, and set the same values in the
# Cloudflare Pages dashboard for production. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Supabase (client-side; safe to expose — these are the PUBLIC keys) ------
# Found in Supabase dashboard > Project Settings > API.
# Leave BOTH blank to run the app in "local mode" (data stays in the browser,
# no login required) — handy for quick local testing without a backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Anthropic AI proxy (SERVER-SIDE ONLY — never prefix with VITE_) ---------
# Used by the Cloudflare Pages Function at /api/ai and by the local dev proxy.
# This key is never sent to the browser. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model the AI proxy uses (defaults to claude-sonnet-5).
# AI_MODEL=claude-sonnet-5

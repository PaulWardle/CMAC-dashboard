{
  // IMPORTANT: `name` must match the Worker's name shown in your Cloudflare
  // dashboard. Cloudflare deploys `wrangler deploy` to the Worker named here,
  // and your environment variables are attached to that Worker — if the names
  // differ, the deploy lands on the wrong Worker and the env vars are missing.
  "name": "cmac-dashboard",
  "compatibility_date": "2024-11-01",
  "main": "worker.js",
  // Daily exceptions digest: 06:00 UTC = 7am UK in summer (BST).
  "triggers": { "crons": ["0 6 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
